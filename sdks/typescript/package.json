{
  "name": "@krymux/sdk",
  "version": "0.2.0",
  "description": "Krymux TypeScript SDK \u2014 TLS 1.3 mTLS tunnels with Ed25519 identities, stream multiplexing and flow control; wire-compatible with the Rust and Node implementations.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*"
  },
  "files": [
    "src",
    "examples",
    "scripts"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "example:echo": "tsx examples/echo.ts",
    "test:isolation": "tsx scripts/test-stream-isolation.ts",
    "test:interop": "tsx scripts/interop-with-rust.ts"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
